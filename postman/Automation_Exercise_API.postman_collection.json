  "item": [
    {
      "name": "Products & Catalog",
      "description": "Endpoints related to product browsing, brands, and search.",
      "item": [
        {
          "name": "GET All Products List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productsList",
              "host": ["{{baseUrl}}"],
              "path": ["productsList"]
            },
            "description": "Retrieve all available products. Validates response code 200 and product list schema."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is acceptable (< 3000ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "",
                  "pm.test(\"Payload responseCode is 200\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.responseCode).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Products array is returned and non-empty\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.products).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Product schema contains expected fields\", function () {",
                  "    var firstProduct = pm.response.json().products[0];",
                  "    pm.expect(firstProduct).to.have.property(\"id\");",
                  "    pm.expect(firstProduct).to.have.property(\"name\");",
                  "    pm.expect(firstProduct).to.have.property(\"price\");",
                  "    pm.expect(firstProduct).to.have.property(\"brand\");",
                  "    pm.expect(firstProduct).to.have.property(\"category\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST All Products List (Unsupported Method)",
          "request": {
