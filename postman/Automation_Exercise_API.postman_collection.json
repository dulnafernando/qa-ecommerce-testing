        {
          "name": "GET User Detail By Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/getUserDetailByEmail?email={{validEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["getUserDetailByEmail"],
              "query": [
                {
                  "key": "email",
                  "value": "{{validEmail}}"
                }
              ]
            },
            "description": "Retrieve user profile details by query parameter. Validates user object fields."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Payload responseCode is 200\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.responseCode).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"User object contains registered email\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user).to.be.an(\"object\");",
                  "    pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"validEmail\"));",
