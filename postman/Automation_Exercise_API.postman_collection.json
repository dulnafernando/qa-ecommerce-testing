              "raw": "{{baseUrl}}/searchProduct",
              "host": ["{{baseUrl}}"],
              "path": ["searchProduct"]
            },
            "description": "Search for products by query term. Validates filtered results matching term."
          },
          "event": [
            {
              "listen": "test",
              "script": {
