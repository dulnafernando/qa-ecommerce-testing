    {
      "name": "Authentication & Accounts",
      "description": "Endpoints related to login verification and user profile inspection.",
      "item": [
        {
          "name": "POST Verify Login (Valid Credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{validEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{validPassword}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/verifyLogin",
              "host": ["{{baseUrl}}"],
              "path": ["verifyLogin"]
            },
            "description": "Positive login verification. Validates user exists confirmation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Payload responseCode is 200\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.responseCode).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Message confirms User exists!\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"User exists!\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Verify Login (Invalid Credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "invalid_user_99999@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "WrongPassword123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/verifyLogin",
              "host": ["{{baseUrl}}"],
              "path": ["verifyLogin"]
            },
            "description": "Negative Test: Verify login with non-existent user. Validates 404 User not found payload."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Transport status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Payload responseCode is 404 Not Found\", function () {",
